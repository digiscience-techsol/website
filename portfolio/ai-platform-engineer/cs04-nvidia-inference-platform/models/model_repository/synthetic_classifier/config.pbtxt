name: "synthetic_classifier"
backend: "onnxruntime"
max_batch_size: 32

input [
  {
    name: "FEATURES"
    data_type: TYPE_FP32
    dims: [4]
  }
]

output [
  {
    name: "PROBABILITIES"
    data_type: TYPE_FP32
    dims: [2]
  }
]

dynamic_batching {
  preferred_batch_size: [4, 8, 16]
  max_queue_delay_microseconds: 2000
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

version_policy {
  latest {
    num_versions: 2
  }
}

parameters {
  key: "portfolio_evidence_status"
  value: { string_value: "configuration-present-model-artifact-not-yet-published" }
}
